# Copy this file to ".env" and adjust the values for your environment.
# Docker Compose reads ".env" automatically. Never commit a real ".env".
#
# The defaults below are safe local demo values. The database credentials are
# also used to seed the demo accounts (see docs/USER_GUIDE.md).

# ---- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=facilitybook
POSTGRES_USER=facilitybook
POSTGRES_PASSWORD=facilitybook

# Host port that exposes the container database. Change it if 5433 is taken.
# (The compose file maps this host port to container port 5432.)
# POSTGRES_HOST_PORT=5433

# ---- Application ----------------------------------------------------------
# Host port that exposes the backend API.
# APP_HOST_PORT=8080

# Timezone used to interpret operating hours and to group report data.
# Operating hours are stored as local wall-clock times, so this must match the
# facility's real timezone. API timestamps always transit as UTC.
APP_TIMEZONE=Europe/Istanbul

# Comma-separated list of browser origins allowed by CORS.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Security (change for anything but a local demo) ----------------------
# HS256 signing key for JWTs. Use a long, random, secret value in production.
APP_JWT_SECRET=facilitybook-dev-secret-key-change-me-0123456789
APP_JWT_EXPIRATION_MINUTES=60

# ---- Reservation reminders (in-app) --------------------------------------
# Set to false to disable the scheduled reminder job.
APP_REMINDERS_ENABLED=true
APP_REMINDERS_INTERVAL_MS=3600000
APP_REMINDERS_HORIZON_HOURS=24
